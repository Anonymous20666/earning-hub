// This deployment uses the server-side SQLite API, not browser Firestore access.
// Fail-closed replacement for the original balance-writable rules.
// Prepared only: these rules have NOT been deployed to any Firebase project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
