NODE_ENV=production
HOST=127.0.0.1
PORT=3107
DATABASE_PATH=./data/pappy.sqlite
# Set to the exact public HTTPS origin after choosing the production domain.
# APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
# Local HTTP development ONLY: COOKIE_SECURE=false
# Payments, paid dispatch, email and AI are deliberately not enabled.
# Personal WhatsApp owner-testing is an explicit opt-in; no connection starts without a linked-device request or saved session.
WHATSAPP_ENABLED=false
# Generate TWO independent 32-byte hex secrets; keep them persistent and private outside Git.
# WA_ENCRYPTION_KEY=<openssl rand -hex 32>
# WA_IDENTITY_KEY=<openssl rand -hex 32>

# Only enable behind deploy/nginx-pappy-earning-hub.conf with the container
# published on loopback. nginx must overwrite client-supplied forwarding headers.
TRUST_PROXY_HOPS=0

# Optional dispatch framework ONLY. The web release does not start a worker/Redis.
# The legacy paid worker is NOT the personal Plogme dispatcher. Enabling this alone cannot pair/send.
BROADCAST_WORKER_ENABLED=false
# REDIS_URL=redis://private-redis:6379
# BROADCAST_PROVIDER_MODULE=<operator-reviewed-adapter-basename>
# TEST_REDIS_URL is for dedicated local queue tests only; never target a live Redis.
