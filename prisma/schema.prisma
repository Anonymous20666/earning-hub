// Prisma Schema for NexusSphere State-Plane Architecture
// PostgreSQL with strict DECIMAL(12,3) for all monetary and coin ledgers

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EARNER
  ADVERTISER
  ADMIN
}

enum SessionTier {
  BRONZE
  SILVER
  GOLD
}

enum SessionStatus {
  ONLINE
  OFFLINE
  INCUBATING
  PAIRING
  BANNED
}

enum GroupStatus {
  OPEN
  LOCKED
  KICKED
}

enum CampaignPathway {
  DIRECT_SESSION
  SMART_VERIFIED
}

enum SmartSystemType {
  WA_GROUP
  WA_CHANNEL
  TG_GROUP
  TG_CHANNEL
}

enum BroadcastMode {
  ALLSTATUS_1X
  ALLCHAT_2X_VIP
}

enum CountryFilterMode {
  RANDOM
  SPECIFIC_COUNTRIES
}

enum CampaignStatus {
  PENDING_ADMIN_VERIFICATION
  VERIFIED_ACTIVE
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED_TIMEOUT
}

enum TicketStatus {
  OPEN
  REPLIED
  RESOLVED
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  name             String?
  role             UserRole            @default(EARNER)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  wallet           Wallet?
  sessions         PairedSession[]
  campaigns        Campaign[]
  deviceFingerprints DeviceFingerprint[]
  supportTickets   SupportTicket[]
}

model Wallet {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Strictly DECIMAL(12,3)
  locked_bonus             Decimal  @default(200.000) @db.Decimal(12, 3)
  earned_balance           Decimal  @default(0.000) @db.Decimal(12, 3)
  pending_referral_balance Decimal  @default(0.000) @db.Decimal(12, 3)
  bonus_claimed            Boolean  @default(false)
  total_withdrawn          Decimal  @default(0.000) @db.Decimal(12, 3)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model DeviceFingerprint {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId   String   @unique
  ipAddress   String
  isVpnOrProxy Boolean @default(false)
  canvasHash  String
  webglHash   String
  createdAt   DateTime @default(now())
}

model PairedJidHistory {
  id         String   @id @default(uuid())
  jidHash    String   @unique // SHA-256 of 23480...@s.whatsapp.net
  pairedAt   DateTime @default(now())
  lastUserId String
}

model PairedSession {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      String
  jid              String         @unique
  deviceHash       String
  tier             SessionTier    @default(BRONZE)
  status           SessionStatus  @default(ONLINE)
  openGcCount      Int            @default(0)
  totalGcCount     Int            @default(0)
  virtualGoldUnits Int            @default(0)
  isOldNumber      Boolean        @default(true)
  pairedAt         DateTime       @default(now())
  lastBroadcastAt  DateTime?
  autoJoinEnabled  Boolean        @default(false)
  groups           SessionGroup[]
}

model SessionGroup {
  id                       String        @id @default(uuid())
  sessionId                String
  session                  PairedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupJid                 String
  subject                  String
  memberCount              Int
  status                   GroupStatus   @default(OPEN)
  isWorkerAdmin            Boolean       @default(false)
  oneXCoins                Decimal       @default(0.000) @db.Decimal(12, 3)
  twoXCoins                Decimal       @default(0.000) @db.Decimal(12, 3)
  lastBroadcastDeliveredAt DateTime?
  kickedAt                 DateTime?
  createdAt                DateTime      @default(now())

  @@unique([sessionId, groupJid])
}

model ValidatedGroupPool {
  id                  String   @id @default(uuid())
  inviteCode          String   @unique
  url                 String
  subject             String
  memberCount         Int
  creatorCountryCode  String
  inferredPrefix      String
  validatedAt         DateTime @default(now())
  assignedUsersCount  Int      @default(0)
}

model AdminBotPool {
  id               String   @id @default(uuid())
  role             String   // PRIMARY, BACKUP, CHANNEL
  phoneNumber      String   @unique
  jid              String   @unique
  status           String   @default("ONLINE") // ONLINE, ACTIVE_IN_GC, OFFLINE
  activeGroupCount Int      @default(0)
  lastHealthPing   DateTime @default(now())
}

model Campaign {
  id                           String              @id @default(uuid())
  advertiserId                 String
  advertiser                   User                @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  title                        String
  pathway                      CampaignPathway
  smartSystemType              SmartSystemType?
  broadcastMode                BroadcastMode       @default(ALLCHAT_2X_VIP)
  targetUrl                    String
  caption                      String
  previewTitle                 String?
  previewDescription           String?
  previewThumbnailUrl          String?
  requestedTier                SessionTier?
  sessionCountRequested        Int?
  requestedVolume              Int?                // Capped at 2,000 for WA_GROUP
  countryFilterMode            CountryFilterMode?  @default(RANDOM)
  targetCountryPrefixes        String[]            @default([])
  // WA_GROUP Workflow 1
  assignedPrimaryBot           String?
  assignedBackupBot            String?
  groupJid                     String?
  verificationTimerSecondsLeft Int?                @default(600)
  verificationTimerExpiresAt   DateTime?
  verifiedAsAdmin              Boolean             @default(false)
  verificationTimedOut         Boolean             @default(false)
  // WA_CHANNEL Workflow 2
  channelVerificationCode      String?             // e.g. "CH-9042"
  channelUserPhone             String?
  channelContactSaved          Boolean             @default(false)
  channelInviteAccepted        Boolean             @default(false)
  // TG_GROUP & TG_CHANNEL Workflows 3 & 4 (Monotonic cumulative counter)
  telegramChatId               String?
  cumulativeRequestsDelivered  Int                 @default(0) // Monotonic counter: never decremented on owner approval
  rejectedWrongCountryCount    Int                 @default(0)
  lastHourlyFilterAt           DateTime?
  // Financial Locks (DECIMAL 12,3)
  costCoins                    Decimal             @db.Decimal(12, 3)
  costNgn                      Decimal             @db.Decimal(12, 3)
  maxWorkerCoinBudget          Decimal             @db.Decimal(12, 3)
  coinsPaidToWorkers           Decimal             @default(0.000) @db.Decimal(12, 3)
  status                       CampaignStatus      @default(PENDING_ADMIN_VERIFICATION)
  createdAt                    DateTime            @default(now())
  completedAt                  DateTime?
  deliveredRequests            DeliveredRequestLog[]
}

model DeliveredRequestLog {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalUserId  String   // telegram_user_id or WhatsApp JID
  platform        String   // WA_GROUP, WA_CHANNEL, TG_GROUP, TG_CHANNEL
  phoneNumber     String?
  countryPrefix   String?
  wasAccepted     Boolean  @default(true)
  rejectionReason String?
  receivedAt      DateTime @default(now())

  // Strict deduplication: the same user is never counted twice
  @@unique([campaignId, externalUserId])
}

model SupportTicket {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail        String
  subject          String
  message          String
  category         String       // VERIFICATION_DISPUTE, WITHDRAWAL_ISSUE, PAIRING, GENERAL
  status           TicketStatus @default(OPEN)
  adminNotes       String?
  telegramNotified Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model SystemPricingConfig {
  id                        String   @id @default("default_config")
  coinToNgnRate             Decimal  @default(1.000) @db.Decimal(12, 3)
  minimumMarginPct          Decimal  @default(0.750) @db.Decimal(12, 3)
  bronzeSessionBaseNgn      Decimal  @default(45.000) @db.Decimal(12, 3)
  silverSessionBaseNgn      Decimal  @default(180.000) @db.Decimal(12, 3)
  goldSessionBaseNgn        Decimal  @default(400.000) @db.Decimal(12, 3)
  vipAllChatMultiplier      Decimal  @default(2.000) @db.Decimal(12, 3)
  specificCountryMultiplier Decimal  @default(1.450) @db.Decimal(12, 3)
  minBroadcastDelayMs       Int      @default(3000)
  maxBroadcastDelayMs       Int      @default(6000)
  joinManagerJitterMinMins  Int      @default(15)
  joinManagerJitterMaxMins  Int      @default(35)
  updatedAt                 DateTime @default(now())
}
